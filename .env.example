# ============================================================
# TigerLite v2 — environment variables
# ============================================================
# Copy this to .env.local at the repo root and fill in values.
# Services read from .env.local via dotenv. Do not commit secrets.
# ============================================================

# ---------- Stage ----------
STAGE=dev                                # dev | staging | prod
LOG_LEVEL=info

# ---------- Supabase / Postgres ----------
# From Supabase project settings.
SUPABASE_URL=https://qetuxfbxnmzvqnsdzdnk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_LKM1gxISqom0pGpSTQTH8A_W2mdkHMQ
# Server-side only. NEVER ship this to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-me-rotated-secret-from-supabase

# Direct Postgres URL (used by control-plane and migrations).
# Format: postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL=postgresql://postgres.qetuxfbxnmzvqnsdzdnk:replace-me@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Used by the dashboard (client-side safe values prefixed with NEXT_PUBLIC).
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# ---------- Object storage ----------
# Local dev: MinIO. Production: AWS S3.
# OBJECT_STORE=minio | s3
OBJECT_STORE=minio

# Buckets
TELEMETRY_BUCKET=tigerlite-dev-telemetry
SNAPSHOTS_BUCKET=tigerlite-dev-snapshots

# MinIO (local dev)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# AWS (production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# ---------- Iceberg REST catalog ----------
ICEBERG_CATALOG_URI=http://localhost:8181
ICEBERG_WAREHOUSE=s3a://tigerlite-dev-telemetry/

# ---------- Service URLs ----------
INGEST_URL=http://localhost:8080
CONTROL_PLANE_URL=http://localhost:8000
DASHBOARD_URL=http://localhost:3000

# ---------- Cryptography ----------
# 32-byte hex string used for envelope encryption of stored OAuth tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_ENCRYPTION_KEY=replace-me-32-byte-hex

# ---------- LLM (Phase 1+) ----------
GEMINI_API_KEY=replace-me-from-aistudio
GEMINI_MODEL_AGENT=gemini-2.5-pro
GEMINI_MODEL_COMPILER=gemini-2.5-flash

# ---------- GitHub App (Phase 2) ----------
# Created at https://github.com/settings/apps
GITHUB_APP_ID=replace-me
GITHUB_APP_SLUG=tigerlite-dev
GITHUB_APP_PRIVATE_KEY_PATH=./.secrets/github-app.pem
GITHUB_APP_CLIENT_ID=replace-me
GITHUB_APP_CLIENT_SECRET=replace-me
GITHUB_APP_WEBHOOK_SECRET=replace-me

# ---------- Slack App (Phase 2) ----------
# Created at https://api.slack.com/apps
SLACK_CLIENT_ID=replace-me
SLACK_CLIENT_SECRET=replace-me
SLACK_SIGNING_SECRET=replace-me
SLACK_BOT_USER_OAUTH_TOKEN=xoxb-replace-me

# ---------- MCP servers ----------
# These are subprocess invocations from the agent runtime.
# Override paths if your MCP binaries live elsewhere.
GITHUB_MCP_COMMAND=github-mcp-server
SLACK_MCP_COMMAND=mcp-server-slack

# ---------- Anthropic (Phase 4 stretch — direct PR creation) ----------
ANTHROPIC_API_KEY=replace-me-or-leave-blank

# ---------- Agent runtime tuning ----------
AGENT_MAX_STEPS=30
AGENT_TOOL_TIMEOUT_SECONDS=60
AGENT_QUERY_RESULT_TOKEN_CAP=5000

# ---------- Watcher cadence ----------
ANOMALY_WATCH_INTERVAL_SECONDS=60
JOB_VISIBILITY_TIMEOUT_SECONDS=300
JOB_REAPER_INTERVAL_SECONDS=60

# ---------- Demo helpers ----------
# When true, the agent compiler will short-circuit clarifying questions if the
# objective is recognised as the canonical demo prompt. Useful for live demos.
DEMO_MODE=false
