{
  "name": "tigerlite",
  "version": "2.0.0-dev",
  "private": true,
  "description": "TigerLite v2 — AI-powered ops platform (FireTiger-style).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tigerlite/dashboard dev",
    "dev:all": "bash scripts/dev.sh",
    "dev:backend": "bash scripts/dev.sh --backend-only",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "bash scripts/apply-migrations.sh",
    "db:reset": "bash scripts/reset-local-db.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
